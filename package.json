    "keywords": [],
    "homepage": "",
    "main": "index.js",
    "scripts": {
        "css": "npm-run-all css-compile css-prefix css-compress",
        "css-compile": "sass src/styles/app.scss public/css/app.css",
        "css-prefix": "postcss public/css/app.css --use=autoprefixer --map=false  --output=public/css/app.css",
        "css-compress": "sass public/css/app.css public/css/app.min.css --style compressed",
        "js": "webpack",
        "build": "npm-run-all css js",
        "watch": "npm-run-all --parallel watch-js watch-css",
        "watch-js": "webpack --watch",
        "watch-css": "watch 'npm run css' src/styles"
    },
    "dependencies": {
        "@floating-ui/dom": "^1.5.3",
        "@foragefox/doubledash": "^1.2.6",
        "@hookform/error-message": "^2.0.1",
