        "@stripe/stripe-js": "^2.2.0",
        "bootstrap": "^5.3.2",
        "classnames": "^2.3.2",
        "prismjs": "^1.29.0",
        "react": "^17.0.1",
        "react-dom": "^17.0.1",
        "react-dropzone": "^14.2.3",
        "react-hook-form": "^7.36.1",
        "react-router-dom": "^6.6.2",
        "react-simple-code-editor": "^0.13.1",
        "react-sortablejs": "^6.1.4",
        "react-toastify": "^9.0.8",
        "rxjs": "^6.6.6",
        "sortablejs": "^1.15.0"
    },
    "devDependencies": {
        "@babel/core": "^7.13.10",
