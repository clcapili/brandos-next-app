        "babel-loader": "^8.2.2",
        "dotenv": "^16.0.3",
        "html-webpack-plugin": "^5.3.1",
        "npm-run-all": "^4.1.5",
        "postcss": "^8.2.8",
        "postcss-cli": "^8.3.1",
        "sass": "^1.32.8",
        "watch": "^0.13.0",
        "webpack": "^5.26.1",
        "webpack-cli": "^4.5.0",
        "webpack-dev-server": "^4.11.1"
    }
